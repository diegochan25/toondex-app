{% extends layout('base.html.j2') %}

{% block title %}Not Found{% endblock %}

{% block body %}
<div class="w-full h-screen flex flex-col items-center justify-center gap-4 bg-app-neutral-100 text-center px-4">
    <i data-lucide="search-x" class="size-10 text-app-neutral-500"></i>
    <h1 class="text-2xl font-semibold text-app-neutral-800">Page not found</h1>
    <p class="text-app-ink-100">
        <span class="font-mono bg-app-neutral-200 px-1.5 py-0.5 rounded">{{ request.url.path }}</span>
        doesn't exist.
    </p>
    <a
        href="/admin/"
        class="mt-2 flex items-center gap-2 px-4 py-2 rounded-lg bg-app-primary-800 text-white hover:bg-app-primary-900 duration-150"
    >
        <i data-lucide="arrow-left" class="size-4"></i>
        <span>Back to admin</span>
    </a>
</div>
{% endblock %}
